{
  "name": "last-commit-standing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "refresh-rising": "tsx scripts/refresh-rising.ts",
    "typecheck": "tsc --noEmit",
    "build-catalog": "tsx scripts/build-catalog.ts",
    "build-rooms": "tsx scripts/build-rooms.ts",
    "build-safari": "tsx scripts/build-safari-page.ts",
    "community": "tsx scripts/add-community.ts",
    "board-admin": "tsx scripts/board-admin.ts",
    "test:board-integration": "node worker/test/integration.mjs",
    "test:board-browser": "node worker/test/board-browser.mjs",
    "board-preview": "worker/dev/preview.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@napi-rs/canvas": "^1.0.11",
    "better-sqlite3": "^13.0.3",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
